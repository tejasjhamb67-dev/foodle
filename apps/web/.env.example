# Puzzle No. 1 is played on this date (YYYY-MM-DD).
NEXT_PUBLIC_FOODLE_LAUNCH=2026-10-01
# Public URL, used in share text and invite links.
NEXT_PUBLIC_SITE_URL=https://foodle.app
# Secret seed for the daily schedule. Change it before launch so answers can't be predicted from the source.
FOODLE_SCHEDULE_SECRET=change-me

# Optional: accounts, friends, groups and leaderboards (Supabase). Leave blank to run guest-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
